# EXAMPLE ONLY. NEVER COMMIT ACTUAL SECRETS. Copy to .env (Git ignored).
# Names only; values are injected locally, via GitHub Actions secrets, or server /opt/biocad/.env.

# --- App runtime ---
APP_ENV=local
TZ=Europe/Moscow
PUBLIC_URL=http://localhost:8080
SESSION_SECRET=
SEED_DEMO_DATA=true
DEMO_PASSWORD=
POSTGRES_USER=biocad
POSTGRES_PASSWORD=
POSTGRES_DB=biocad
DATABASE_URL=

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
# Candidate: google/gemma-4-26b-a4b-it:free. Validate real-free acceptance before enabling (WB-12).
OPENROUTER_FALLBACK_MODEL=
ASSISTANT_PROPOSAL_SECRET=
# Total conservative reservation cap per epoch (USD), persisted by Booking Service.
# Zero disables paid AI. Set only after model/budget approval; never reset an epoch automatically.
ASSISTANT_BUDGET_USD=0
ASSISTANT_FREE_ONLY=true
ASSISTANT_BUDGET_EPOCH=demo-v1
ASSISTANT_REQUESTS_PER_MINUTE=3

# --- Mail catcher (Mailpit) ---
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_USER=
MAILPIT_UI_PASSWORD=
NOTIFICATIONS_ENABLED=true
NOTIFICATION_PUBLIC_URL=http://localhost:8080

# --- Broker (local defaults are for demo infrastructure only) ---
RABBITMQ_USER=biocad
RABBITMQ_PASSWORD=
RABBITMQ_URL=

# --- Delivery tooling (local agent + CI only, never in app containers) ---
GITHUB_TOKEN=
GITHUB_REPO=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKERHUB_IMAGE_NAMESPACE=
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PASS=
DEPLOY_SSH_KEY_PATH=
CI_DEPLOY_SSH_KEY_PATH=
